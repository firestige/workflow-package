{
  "kind": "agentops.roles", "schemaVersion": "agentops.workflow-dsl@2.0.0",
  "roles": [
    { "id": "role.greeter", "name": "Greeter", "responsibility": "Produce one concise structured greeting from only the admitted TaskPrompt.", "authorityBoundary": { "concerns": ["responsibility", "mission", "data"], "writePermissions": [{ "target": "greeting result", "scope": "write" }], "prohibited": ["using tools", "changing Workflow control flow", "changing Provider binding"] }, "independence": { "isolation": "shared", "barrier": false } },
    { "id": "role.reviewer", "name": "Greeting Reviewer", "responsibility": "Review the immutable greeting and produce the final structured result.", "authorityBoundary": { "concerns": ["responsibility", "method", "data"], "writePermissions": [{ "target": "review result", "scope": "write" }], "prohibited": ["rewriting the greeting", "using tools", "changing Provider binding"] }, "independence": { "isolation": "session-isolated", "barrier": false } }
  ]
}
