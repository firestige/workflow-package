{
  "kind": "agentops.workflow-definition",
  "schemaVersion": "agentops.workflow-dsl@2.0.0",
  "workflow": {
    "id": "hello-world-workflow",
    "name": "Hello World Dual Provider Workflow",
    "version": "0.2.0",
    "purpose": "Prove one Delivery can route two immutable Roles to two different exact Agent Providers and return a structured reviewed greeting.",
    "contractVersion": "agentops.workflow-dsl@2.0.0"
  },
  "state": { "fields": [] },
  "graph": {
    "start": "node.greet",
    "nodes": [
      { "id": "node.greet", "kind": "action", "action": "action.greet" },
      { "id": "node.review", "kind": "action", "action": "action.review" }
    ],
    "edges": [
      { "id": "edge.greet-review", "from": "node.greet", "to": "node.review" },
      { "id": "edge.review-success", "from": "node.review", "to": "terminal:SUCCESS" }
    ],
    "eventEdges": [
      { "id": "event.greet-cancelled", "from": "node.greet", "event": "cancelled", "to": "terminal:CANCELLED" },
      { "id": "event.greet-failed", "from": "node.greet", "event": "nonretryable-failure", "to": "terminal:FAILED" },
      { "id": "event.review-cancelled", "from": "node.review", "event": "cancelled", "to": "terminal:CANCELLED" },
      { "id": "event.review-failed", "from": "node.review", "event": "nonretryable-failure", "to": "terminal:FAILED" }
    ],
    "terminals": [
      { "id": "SUCCESS", "kind": "success", "meaning": "Both frozen Roles completed through their exact Providers.", "proposalCheckpoint": true },
      { "id": "FAILED", "kind": "failure", "meaning": "A frozen Role or Provider failed closed.", "proposalCheckpoint": true },
      { "id": "CANCELLED", "kind": "cancelled", "meaning": "The Delivery was explicitly cancelled.", "proposalCheckpoint": true }
    ]
  },
  "dataflow": {
    "edges": [
      {
        "id": "data.greeting-to-review",
        "source": { "kind": "site-result", "site": { "kind": "node", "nodeIdentity": "node.greet" }, "slot": { "kind": "whole" } },
        "target": { "kind": "site-input", "site": { "kind": "node", "nodeIdentity": "node.review" }, "slot": { "kind": "whole" } }
      }
    ]
  }
}
