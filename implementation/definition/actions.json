{
  "kind": "agentops.actions",
  "schemaVersion": "agentops.workflow-dsl@1.0.0",
  "actions": [
    {
      "id": "action.IM-01",
      "name": "Intake and Authority Scan",
      "purpose": "Bind exact frozen design identity, authority order, target scope and repository context; classify every upstream handoff obligation without accepting upstream control over this Workflow's lifecycle.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "upstreamDesign": {
            "type": "object"
          }
        },
        "required": [
          "request"
        ]
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "authorityBound": {
            "type": "boolean"
          },
          "designIdentityExact": {
            "type": "boolean"
          },
          "obligationRegisterBound": {
            "type": "boolean"
          },
          "derivableFactMissing": {
            "type": "boolean"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "intake-preflight",
              "intake-research",
              "unmatched"
            ]
          }
        },
        "required": [
          "authorityBound",
          "designIdentityExact",
          "obligationRegisterBound",
          "derivableFactMissing",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.goal-facilitator"
      },
      "allowedRoutes": [
        "route.goal.facilitator"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.intake-checks"
        ]
      }
    },
    {
      "id": "action.IM-01R",
      "name": "Bounded Evidence Research",
      "purpose": "Resolve one repository/manual/tool fact and return only to its recorded requesting Action; never decides, writes, changes Goals or launches a Workflow.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "requestingAction": {
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "requestingAction"
        ]
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observation": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "routing": {
            "type": "string",
            "enum": [
              "research-intake",
              "research-grilling",
              "unmatched"
            ]
          }
        },
        "required": [
          "resolved",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.evidence-scout"
      },
      "allowedRoutes": [
        "route.evidence.scout"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.intake-checks"
        ]
      }
    },
    {
      "id": "action.IM-02",
      "name": "Implementation Preflight",
      "purpose": "Check clean worktree, design status/identity, project-native build/test/coverage/static commands, safe test isolation, obligation classification completeness, Contract availability facts, and tool/permission availability for admitted feasibility checks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "design": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "passed": {
            "type": "boolean"
          },
          "feasibilityObligations": {
            "type": "integer"
          },
          "harnessBinding": {
            "type": "object"
          },
          "contractAvailability": {
            "type": "object"
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "preflight-feasibility",
              "preflight-grilling",
              "unmatched"
            ]
          }
        },
        "required": [
          "passed",
          "feasibilityObligations",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.delivery-custodian"
      },
      "allowedRoutes": [
        "route.delivery.custodian"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.preflight-checks",
          "validator.cli-checks"
        ]
      }
    },
    {
      "id": "action.IM-02V",
      "name": "Implementation Feasibility Validation",
      "purpose": "Resolve implementation-owned version/SDK/substrate questions before Goal freeze with bounded probes in the ignored run workspace and exact argv; never makes architecture decisions or writes repository deliverables.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "obligations": {
            "type": "array"
          },
          "harness": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "allCalibrated": {
            "type": "boolean"
          },
          "pendingWithProgress": {
            "type": "boolean"
          },
          "externalUnavailable": {
            "type": "boolean"
          },
          "reopen": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "feasibility-grilling",
              "feasibility-self",
              "feasibility-reopen",
              "wait-external",
              "unmatched"
            ]
          }
        },
        "required": [
          "allCalibrated",
          "pendingWithProgress",
          "externalUnavailable",
          "reopen",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.implementation-feasibility-validator"
      },
      "allowedRoutes": [
        "route.feasibility.validator"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.feasibility-checks"
        ]
      }
    },
    {
      "id": "action.IM-03",
      "name": "Adaptive Grilling and Goal Classification",
      "purpose": "Derive Project Context Snapshot, Goal Packets, dependencies, completion boundary, semantic Test Ladders and classified blockers; ask one decision at a time and investigate facts first.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "design": {
            "type": "object"
          },
          "preflight": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "allClassified": {
            "type": "boolean"
          },
          "needsUser": {
            "type": "boolean"
          },
          "ambiguity": {
            "type": "boolean"
          },
          "projectContextSnapshot": {
            "type": "object"
          },
          "goalPackets": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "continue",
              "wait-user",
              "unmatched"
            ]
          }
        },
        "required": [
          "allClassified",
          "needsUser",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.goal-facilitator"
      },
      "allowedRoutes": [
        "route.goal.facilitator"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.grilling-checks"
        ]
      }
    },
    {
      "id": "action.IM-04",
      "name": "Confirm and Freeze Goal Graph",
      "purpose": "Facilitator prepares; human confirms; executor persists the exact frozen artifacts. Every upstream obligation mapped; no unresolved user decision remains.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goalGraphProposal": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "frozen": {
            "type": "boolean"
          },
          "correctionRequired": {
            "type": "boolean"
          },
          "goals": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "confirm-grilling",
              "confirm-branch",
              "wait-user",
              "unmatched"
            ]
          }
        },
        "required": [
          "frozen",
          "correctionRequired",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.goal-facilitator"
      },
      "allowedRoutes": [
        "route.goal.facilitator"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.goal-graph-checks"
        ]
      }
    },
    {
      "id": "action.IM-05",
      "name": "Activate Feature Branch",
      "purpose": "Require a clean baseline, create a new feature branch and record the baseline commit; never auto-stash, reset, merge or reuse a conflicting branch.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "baseline": {
            "type": "string"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "activated": {
            "type": "boolean"
          },
          "branch": {
            "type": "string"
          },
          "baselineCommit": {
            "type": "string"
          }
        },
        "required": [
          "activated"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.delivery-custodian"
      },
      "allowedRoutes": [
        "route.delivery.custodian"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.branch-checks",
          "validator.cli-checks"
        ]
      }
    },
    {
      "id": "action.IM-06",
      "name": "Select Ready Goal and Rung",
      "purpose": "Deterministic Workflow selector: Harness prerequisite, then minimum end-to-end Walking Skeleton, then topological Goal/Test Ladder order; Implementer preference cannot choose the next Goal.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goalGraph": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "goalRungReady": {
            "type": "boolean"
          },
          "allGoalsCommitted": {
            "type": "boolean"
          },
          "missingContract": {
            "type": "boolean"
          },
          "selectedGoal": {
            "type": "string"
          },
          "selectedRung": {
            "type": "string"
          },
          "routing": {
            "type": "string",
            "enum": [
              "select-calibrate",
              "select-whole",
              "wait-external",
              "unmatched"
            ]
          }
        },
        "required": [
          "goalRungReady",
          "allGoalsCommitted",
          "missingContract",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "runtime",
        "validator": "validator.selection-checks"
      },
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.selection-checks"
        ]
      }
    },
    {
      "id": "action.IM-07",
      "name": "Materialize and Calibrate Tests",
      "purpose": "Turn the current semantic rung into black-box tests and prove discriminating power; current behavior must fail for the expected reason, or existing-green must be challenged by a negative fixture or controlled mutant.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "object"
          },
          "rung": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "calibrated": {
            "type": "boolean"
          },
          "ambiguity": {
            "type": "boolean"
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "calibrate-evolve",
              "calibrate-grilling",
              "unmatched"
            ]
          }
        },
        "required": [
          "calibrated",
          "ambiguity",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.test-designer"
      },
      "allowedRoutes": [
        "route.test.designer.blackbox"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.calibration-checks",
          "validator.writer-policy"
        ]
      }
    },
    {
      "id": "action.IM-08",
      "name": "Evolve Prototype to Green",
      "purpose": "Make the smallest production-code change that turns the calibrated RED into GREEN; no formal test, fixture, Harness, coverage or writer-policy changes; diagnostic probes stay ignored and non-authoritative.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "redFeedback": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "expectedRedProgress": {
            "type": "boolean"
          },
          "green": {
            "type": "boolean"
          },
          "changedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "evolve-self",
              "evolve-close",
              "unmatched"
            ]
          }
        },
        "required": [
          "expectedRedProgress",
          "green",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.implementer"
      },
      "allowedRoutes": [
        "route.implementation.standard"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.evolve-checks",
          "validator.writer-policy"
        ]
      }
    },
    {
      "id": "action.IM-09",
      "name": "Close Structural Coverage",
      "purpose": "Classify changed branches and add assertions for behavior-relevant branches in a code-aware fresh session; new/modified behavior-bearing branches require 100% coverage plus branch-specific assertions; historical coverage cannot regress.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "diff": {
            "type": "object"
          },
          "coverageMap": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "branchRedIntroduced": {
            "type": "boolean"
          },
          "branchesClosed": {
            "type": "boolean"
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "close-evolve",
              "close-refactor",
              "unmatched"
            ]
          }
        },
        "required": [
          "branchRedIntroduced",
          "branchesClosed",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.test-designer"
      },
      "allowedRoutes": [
        "route.test.designer.structural"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.coverage-checks",
          "validator.writer-policy"
        ]
      }
    },
    {
      "id": "action.IM-10",
      "name": "Bounded Refactor and Hardening",
      "purpose": "Improve the current prototype without changing frozen behavior; no speculative abstraction, future feature, generic machinery or unrelated cleanup; NO_REFACTOR_NEEDED is valid.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "greenCandidate": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "regression": {
            "type": "boolean"
          },
          "noRefactorOrGreen": {
            "type": "boolean"
          },
          "changedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "refactor-evolve",
              "refactor-verify",
              "unmatched"
            ]
          }
        },
        "required": [
          "regression",
          "noRefactorOrGreen",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.implementer"
      },
      "allowedRoutes": [
        "route.implementation.standard"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.refactor-checks",
          "validator.writer-policy"
        ]
      }
    },
    {
      "id": "action.IM-11",
      "name": "Verify Rung",
      "purpose": "Check current tests, affected regression, writer policy, stub ledger and Action evidence against one Git baseline; random rerun to obtain GREEN is prohibited.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "anotherRung": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "invalidFeedback": {
            "type": "boolean"
          },
          "returnAction": {
            "type": "string"
          },
          "routing": {
            "type": "string",
            "enum": [
              "verify-calibrate",
              "verify-review",
              "verify-return07",
              "verify-return08",
              "verify-return09",
              "verify-return10",
              "unmatched"
            ]
          }
        },
        "required": [
          "anotherRung",
          "verified",
          "invalidFeedback",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.delivery-custodian"
      },
      "allowedRoutes": [
        "route.delivery.custodian"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.rung-verify",
          "validator.cli-checks"
        ]
      }
    },
    {
      "id": "action.IM-12.blackbox",
      "name": "Independent Goal Black-box Review",
      "purpose": "Review the exact Goal candidate only through the isolated black-box Goal lens, without inspecting implementation details before this result freezes; emit immutable externally observable counterexamples or Findings and do not aggregate or act for the white-box reviewer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goalCandidate": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "findings"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.goal-adversary"
      },
      "allowedRoutes": [
        "route.review.goal-blackbox"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.review-isolation"
        ]
      }
    },
    {
      "id": "action.IM-12.whitebox",
      "name": "Independent Goal White-box Review",
      "purpose": "Review the exact Goal candidate only through the isolated white-box Implementation lens; inspect implementation structure, writer boundary and Contract fidelity, emit immutable Findings, and do not aggregate or act for the black-box reviewer.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goalCandidate": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "findings"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.implementation-reviewer"
      },
      "allowedRoutes": [
        "route.review.implementation-whitebox"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.review-isolation"
        ]
      }
    },
    {
      "id": "action.IM-13",
      "name": "Aggregate and Route Findings",
      "purpose": "Preserve provenance, merge clear common causes, detect conflicts and route each Finding; never votes, never changes severity, never edits tests/code and never closes Findings.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "reviewResults": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "string",
            "enum": [
              "none",
              "test",
              "implementation"
            ]
          },
          "routedFindings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "routing": {
            "type": "string",
            "enum": [
              "aggregate-commit",
              "aggregate-resolveTest",
              "aggregate-resolveImpl",
              "unmatched"
            ]
          }
        },
        "required": [
          "finding",
          "routing"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.finding-aggregator"
      },
      "allowedRoutes": [
        "route.finding.aggregate"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.aggregation-rules"
        ]
      }
    },
    {
      "id": "action.IM-14T",
      "name": "Test-side Targeted Resolution",
      "purpose": "Test Designer may add or repair feedback strictly within the frozen Goal; any requested semantic expansion stops this Delivery.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "object"
          },
          "treatment": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "treatmentRecorded": {
            "type": "boolean"
          }
        },
        "required": [
          "treatmentRecorded"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.test-designer"
      },
      "allowedRoutes": [
        "route.test.designer.blackbox",
        "route.test.designer.structural"
      ],
      "gate": {
        "freeTextBypass": "prohibited",
        "deterministic": [
          "validator.resolution-checks",
          "validator.writer-policy"
        ]
      }
    },
    {
      "id": "action.IM-14I",
      "name": "Implementation-side Targeted Resolution",
      "purpose": "Implementer may modify production code only, within the frozen Goal; negative feedback order is failing executable test, deterministic rule, then structured semantic recheck.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "finding": {
            "type": "object"
          },
          "treatment": {
            "type": "object"
          }
        }
      },
      "resultSchema": {
        "type": "object",
        "properties": {
          "treatmentRecorded": {
            "type": "boolean"
          }
        },
        "required": [
          "treatmentRecorded"
        ]
      },
      "responsibleAuthority": {
        "kind": "role",
        "role": "role.implementer"
